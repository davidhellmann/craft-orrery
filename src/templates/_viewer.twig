<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ title }}</title>
<link rel="icon" href="data:image/svg+xml,{{ ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14"/><g fill="#fff" transform="matrix(.72 0 0 .72 8.96 8.96)">' ~ mark ~ '</g></svg>')|url_encode }}">
<script>
  (() => {
    let t = null;
    try { t = localStorage.getItem('orrery-theme'); } catch (e) {}
    document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  })();
</script>
<style>
{{ styles|raw }}
</style>
</head>
<body>
<header class="top">
  <a class="brand" href="#graph">
    <svg viewBox="2 2 60 60" fill="currentColor" aria-hidden="true">{{ mark|raw }}</svg>
    <span>{{ title }}</span>
  </a>
  <nav class="views" id="views" aria-label="Views"></nav>
  <div class="access" id="access"></div>
  <div class="stats" id="stats"></div>
  <div class="top-end">
    <span class="meta" id="meta"></span>
    <button class="icon-btn" id="theme" type="button" aria-label="Toggle colour theme" title="Toggle colour theme"></button>
  </div>
</header>
<main id="main"></main>
<script>
window.CONTENT_MODEL = {{ data|raw }};
</script>
<script>
{{ script|raw }}
</script>
</body>
</html>
